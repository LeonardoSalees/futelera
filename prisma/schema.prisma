// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// Jogador e suas estatísticas acumuladas
model Player {
  id              String   @id @default(cuid())
  name            String
  age             Int?
  avatarURL       String?
  rating          Int      @default(3) // 1 a 5
  isActive        Boolean  @default(true)
  
  // Relações para as estatísticas
  goals           Goal[]   @relation("PlayerGoals")
  assists         Goal[]   @relation("PlayerAssists")
  
  createdAt       DateTime @default(now())
}

// Uma "Pelada" (A noite de quinta)
model MatchDay {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  matches   Match[]
}

// Uma partida individual dentro da noite (Ex: Time A x Time B)
model Match {
  id           String    @id @default(cuid())
  matchDayId   String
  matchDay     MatchDay  @relation(fields: [matchDayId], references: [id])
  
  teamAName    String    @default("Time A")
  teamBName    String    @default("Time B")
  scoreA       Int       @default(0)
  scoreB       Int       @default(0)
  
  goals        Goal[]
  createdAt    DateTime  @default(now())
}

// O registro do Gol (com a assistência vinculada)
model Goal {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id])
  
  playerId     String
  player       Player   @relation("PlayerGoals", fields: [playerId], references: [id])
  
  assistantId  String?  // Opcional para gols individuais
  assistant    Player?  @relation("PlayerAssists", fields: [assistantId], references: [id])
  
  createdAt    DateTime @default(now())
}